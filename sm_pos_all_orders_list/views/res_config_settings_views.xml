<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_orders" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.orders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="after">
                <block title="POS All Orders List" id="pos_all_orders_section"
                       help="Select among the given options to load orders that you wish to load in current POS Session">
                    <setting id="pos_order_load_type_setting" string="Loading Options"
                             help="Choose which orders to preload into the running POS session">
                        <field name="pos_order_load_type" widget="radio"/>
                        <div class="mt-2" invisible="pos_order_load_type != 'days'">
                            <label for="pos_order_load_days" string="Number of days"/>
                            <field name="pos_order_load_days" class="oe_inline"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
